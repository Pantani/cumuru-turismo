APP_ENV={{ cumuru_environment }}
HTTP_ADDRESS=0.0.0.0:8080
OPERATIONS_ADDRESS=0.0.0.0:9090
WORKER_OPERATIONS_ADDRESS=0.0.0.0:9091
DATABASE_URL=postgresql://cumuru_app:{{ cumuru_runtime_secret.database_app_password }}@{{ cumuru_rds_address }}:{{ cumuru_database_port }}/{{ cumuru_database_name }}?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem
DATABASE_TIMEOUT=3s
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
OIDC_MODE=real
OIDC_ISSUER={{ cumuru_oidc_issuer }}
OIDC_AUDIENCE={{ cumuru_oidc_audience }}
OIDC_HTTP_TIMEOUT=5s
OTEL_EXPORTER=otlp
OTEL_ENDPOINT={{ cumuru_otel_endpoint }}
OTEL_TIMEOUT=5s
TRUSTED_PROXY_CIDRS={{ cumuru_trusted_proxy_cidr }}

# Autenticação local por e-mail e senha: é o acesso do operador sem CNPJ,
# Cadastur ou chave federal, e não substitui o IdP quando ele existe.
LOCAL_AUTH_ENABLED={{ cumuru_local_auth_enabled | default(true) | string | lower }}
SESSION_IDLE_TTL={{ cumuru_session_idle_ttl | default('30m') }}
SESSION_ABSOLUTE_TTL={{ cumuru_session_absolute_ttl | default('12h') }}
LOGIN_MAX_FAILED_ATTEMPTS={{ cumuru_login_max_failed_attempts | default(5) }}
LOGIN_LOCKOUT_DURATION={{ cumuru_login_lockout_duration | default('15m') }}

INVITE_BASE_URL=https://{{ cumuru_domain }}/convites
INVITE_TTL=72h
IDEMPOTENCY_TTL=720h
RATE_LIMIT_WINDOW=1m
INVITE_CONTEXT_RATE_LIMIT=30
INVITE_SUBMIT_RATE_LIMIT=10
CORS_ALLOWED_ORIGINS=https://{{ cumuru_domain }}

# O cadastro autônomo de hospedagem é recusado fora de local|test.
ACCOMMODATION_ONBOARDING_ENABLED=false

INVITE_HMAC_CURRENT_VERSION={{ cumuru_environment }}-v1
INVITE_HMAC_KEYS={{ cumuru_environment }}-v1={{ cumuru_runtime_secret.invite_hmac_key }}
ACTOR_HMAC_CURRENT_VERSION={{ cumuru_environment }}-v1
ACTOR_HMAC_KEYS={{ cumuru_environment }}-v1={{ cumuru_runtime_secret.actor_hmac_key }}
IDEMPOTENCY_HMAC_CURRENT_VERSION={{ cumuru_environment }}-v1
IDEMPOTENCY_HMAC_KEYS={{ cumuru_environment }}-v1={{ cumuru_runtime_secret.idempotency_hmac_key }}
RATE_LIMIT_HMAC_CURRENT_VERSION={{ cumuru_environment }}-v1
RATE_LIMIT_HMAC_KEYS={{ cumuru_environment }}-v1={{ cumuru_runtime_secret.rate_limit_hmac_key }}
CURSOR_HMAC_CURRENT_VERSION={{ cumuru_environment }}-v1
CURSOR_HMAC_KEYS={{ cumuru_environment }}-v1={{ cumuru_runtime_secret.cursor_hmac_key }}
DOCUMENT_HMAC_CURRENT_VERSION={{ cumuru_environment }}-v1
DOCUMENT_HMAC_KEYS={{ cumuru_environment }}-v1={{ cumuru_runtime_secret.document_hmac_key }}

# A implementação atual rejeita estas fases fora de local|test.
PHASE3_ENABLED=false
PHASE4_ENABLED=false

# Semeadura de bootstrap. Fica inerte enquanto SEED_ENABLED não for verdadeiro;
# o perfil admin+demo é recusado fora de local|test. A senha vale só para o
# primeiro acesso: a conta nasce marcada para troca obrigatória.
SEED_ENABLED={{ cumuru_seed_enabled | default(false) | string | lower }}
SEED_PROFILE=admin
SEED_ADMIN_EMAIL={{ cumuru_seed_admin_email | default('') }}
SEED_ADMIN_DISPLAY_NAME={{ cumuru_seed_admin_display_name | default('Administração Cumuru') }}
SEED_ADMIN_PASSWORD={{ cumuru_runtime_secret.seed_admin_password | default('') }}
SEED_ADMIN_MUST_CHANGE_PASSWORD=true
SEED_ACCOMMODATION_CATALOG={{ cumuru_seed_catalog_path | default('') }}
PROVISIONING_DATABASE_URL=postgresql://cumuru_migration:{{ cumuru_runtime_secret.database_migration_password | default('') }}@{{ cumuru_rds_address }}:{{ cumuru_database_port }}/{{ cumuru_database_name }}?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem
