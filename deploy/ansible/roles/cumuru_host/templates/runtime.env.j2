APP_ENV={{ cumuru_environment }}
HTTP_ADDRESS=0.0.0.0:8080
OPERATIONS_ADDRESS=0.0.0.0:9090
WORKER_OPERATIONS_ADDRESS=0.0.0.0:9091
DATABASE_URL=postgresql://cumuru_app:{{ cumuru_runtime_secret.database_app_password }}@{{ cumuru_rds_address }}:{{ cumuru_database_port }}/{{ cumuru_database_name }}?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem
DATABASE_TIMEOUT=3s
LOG_LEVEL=info
OIDC_MODE=real
OIDC_ISSUER={{ cumuru_oidc_issuer }}
OIDC_AUDIENCE={{ cumuru_oidc_audience }}
OIDC_HTTP_TIMEOUT=5s
OTEL_EXPORTER=otlp
OTEL_ENDPOINT={{ cumuru_otel_endpoint }}
OTEL_TIMEOUT=5s
TRUSTED_PROXY_CIDRS={{ cumuru_trusted_proxy_cidr }}

INVITE_BASE_URL=https://{{ cumuru_domain }}/convites
INVITE_TTL=72h
IDEMPOTENCY_TTL=720h
RATE_LIMIT_WINDOW=1m
INVITE_CONTEXT_RATE_LIMIT=30
INVITE_SUBMIT_RATE_LIMIT=10
CORS_ALLOWED_ORIGINS=https://{{ cumuru_domain }}

INVITE_HMAC_CURRENT_VERSION={{ cumuru_environment }}-v1
INVITE_HMAC_KEYS={{ cumuru_environment }}-v1={{ cumuru_runtime_secret.invite_hmac_key }}
ACTOR_HMAC_CURRENT_VERSION={{ cumuru_environment }}-v1
ACTOR_HMAC_KEYS={{ cumuru_environment }}-v1={{ cumuru_runtime_secret.actor_hmac_key }}
IDEMPOTENCY_HMAC_CURRENT_VERSION={{ cumuru_environment }}-v1
IDEMPOTENCY_HMAC_KEYS={{ cumuru_environment }}-v1={{ cumuru_runtime_secret.idempotency_hmac_key }}
RATE_LIMIT_HMAC_CURRENT_VERSION={{ cumuru_environment }}-v1
RATE_LIMIT_HMAC_KEYS={{ cumuru_environment }}-v1={{ cumuru_runtime_secret.rate_limit_hmac_key }}
CURSOR_HMAC_CURRENT_VERSION={{ cumuru_environment }}-v1
CURSOR_HMAC_KEYS={{ cumuru_environment }}-v1={{ cumuru_runtime_secret.cursor_hmac_key }}

# A implementação atual rejeita estas fases fora de local|test.
PHASE3_ENABLED=false
PHASE4_ENABLED=false
