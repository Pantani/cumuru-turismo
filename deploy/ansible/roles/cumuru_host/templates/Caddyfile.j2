{
	admin off
	email {$ACME_EMAIL}

	log default {
		output discard
	}
}

{$CUMURU_DOMAIN} {
	@api path /api/v1/*

	handle @api {
		reverse_proxy api:8080 {
			header_up -Forwarded
			header_up -Referer
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		reverse_proxy web:8080
	}
}
