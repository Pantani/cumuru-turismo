# Modelo do runtime.env de staging/produção. Todos os valores aqui são
# placeholders inválidos e existem só para documentar as chaves exigidas: o
# arquivo real é renderizado por deploy/ansible a partir do secret manager e
# nunca é versionado.
#
# Valide antes de subir qualquer coisa:
#   make prod-config-check RUNTIME_ENV=deploy/runtime.env
#
# Produção recusa, por construção: sslmode diferente de verify-full, OIDC fake,
# OTEL_EXPORTER=none, URL http e perfil de seed com fixtures.

APP_ENV=production
HTTP_ADDRESS=0.0.0.0:8080
OPERATIONS_ADDRESS=0.0.0.0:9090
WORKER_OPERATIONS_ADDRESS=0.0.0.0:9091
LOG_LEVEL=info

DATABASE_URL=postgresql://cumuru_app:SENHA@banco.invalid:5432/cumuru?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem
DATABASE_TIMEOUT=3s

OIDC_MODE=real
OIDC_ISSUER=https://identidade.invalid
OIDC_AUDIENCE=cumuru
OIDC_HTTP_TIMEOUT=5s

OTEL_EXPORTER=otlp
OTEL_ENDPOINT=https://telemetria.invalid/v1/traces
OTEL_TIMEOUT=5s

TRUSTED_PROXY_CIDRS=10.0.0.10/32

INVITE_BASE_URL=https://dominio.invalid/convites
INVITE_TTL=72h
IDEMPOTENCY_TTL=720h
RATE_LIMIT_WINDOW=1m
INVITE_CONTEXT_RATE_LIMIT=30
INVITE_SUBMIT_RATE_LIMIT=10
CORS_ALLOWED_ORIGINS=https://dominio.invalid

INVITE_HMAC_CURRENT_VERSION=producao-v1
INVITE_HMAC_KEYS=producao-v1=U1VCU1RJVFVJUi1QT1ItQ0hBVkUtREUtMzItQllURVMtMDA=
ACTOR_HMAC_CURRENT_VERSION=producao-v1
ACTOR_HMAC_KEYS=producao-v1=U1VCU1RJVFVJUi1QT1ItQ0hBVkUtREUtMzItQllURVMtMDE=
IDEMPOTENCY_HMAC_CURRENT_VERSION=producao-v1
IDEMPOTENCY_HMAC_KEYS=producao-v1=U1VCU1RJVFVJUi1QT1ItQ0hBVkUtREUtMzItQllURVMtMDI=
RATE_LIMIT_HMAC_CURRENT_VERSION=producao-v1
RATE_LIMIT_HMAC_KEYS=producao-v1=U1VCU1RJVFVJUi1QT1ItQ0hBVkUtREUtMzItQllURVMtMDM=
CURSOR_HMAC_CURRENT_VERSION=producao-v1
CURSOR_HMAC_KEYS=producao-v1=U1VCU1RJVFVJUi1QT1ItQ0hBVkUtREUtMzItQllURVMtMDQ=

# A implementação atual rejeita estas fases fora de local|test.
PHASE3_ENABLED=false
PHASE4_ENABLED=false

# Semeadura de bootstrap. Deixe SEED_ENABLED=false depois do primeiro deploy:
# a conta já existe e o seeder não repõe a senha trocada.
SEED_ENABLED=false
SEED_PROFILE=admin
SEED_ADMIN_EMAIL=administracao@dominio.invalid
SEED_ADMIN_DISPLAY_NAME=Administração Cumuru
SEED_ADMIN_PASSWORD=SUBSTITUIR-POR-SEGREDO-DO-SECRET-MANAGER
SEED_ACCOMMODATION_CATALOG=/seeds/accommodations.production.json
PROVISIONING_DATABASE_URL=postgresql://cumuru_migration:SENHA@banco.invalid:5432/cumuru?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem
