{
  "name": "cumuru",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "openapi:lint": "redocly lint contracts/openapi.yaml",
    "generate:web": "openapi-typescript contracts/openapi.yaml -o apps/web/src/generated/schema.ts",
    "sbom:web": "npm sbom --workspace @cumuru/web --sbom-format cyclonedx > artifacts/sbom/web.cdx.json"
  },
  "devDependencies": {
    "@redocly/cli": "2.41.0",
    "openapi-typescript": "7.13.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "engines": {
    "node": ">=26.5.0",
    "npm": ">=11.17.0"
  }
}
