# syntax=docker/dockerfile:1.7

# Development image only. It runs the Vite dev server with HMR against a
# bind-mounted source tree; production keeps serving the static build through
# the unprivileged Nginx image in apps/web/Dockerfile.
FROM node:26.5.0-alpine3.23@sha256:0473b6671ff22c8eeb570c0e1e51408595d3171e73f8002c269b763f0a943149

WORKDIR /src

# The install runs at build time so a container restart does not wait on npm.
# node_modules then lives in a named volume, which also keeps the host tree free
# of platform-specific binaries.
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
RUN --mount=type=cache,target=/root/.npm \
    npm ci

COPY apps/web/ apps/web/

EXPOSE 5173

CMD ["npm", "--workspace", "@cumuru/web", "run", "dev"]
