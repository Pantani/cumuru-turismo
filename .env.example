# Somente protótipo local/teste com dados e chaves fictícios.
# Nenhum valor deste arquivo é segredo ou pode ser reutilizado em produção.
APP_ENV=local
HTTP_ADDRESS=127.0.0.1:8080
OPERATIONS_ADDRESS=127.0.0.1:9090
DATABASE_URL=postgres://cumuru_app:cumuru-local-app-only@127.0.0.1:5432/cumuru?sslmode=disable
PUBLIC_DATABASE_URL=postgres://cumuru_public:cumuru-local-public-only@127.0.0.1:5432/cumuru?sslmode=disable
OIDC_MODE=fake
OIDC_ISSUER=https://oidc.invalid/local
OIDC_AUDIENCE=cumuru-local
OTEL_EXPORTER=none
# API + Vite nativos no host confiam somente em loopback.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Compose usa uma variável separada e confia somente no container web.
COMPOSE_TRUSTED_PROXY_CIDRS=172.30.0.10/32

INVITE_BASE_URL=http://127.0.0.1:4173/convites
INVITE_TTL=72h
IDEMPOTENCY_TTL=720h
RATE_LIMIT_WINDOW=1m
INVITE_CONTEXT_RATE_LIMIT=30
INVITE_SUBMIT_RATE_LIMIT=10
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:5173

# Fixtures deliberadamente legíveis, independentes e exclusivas de local/teste.
INVITE_HMAC_CURRENT_VERSION=local-v1
INVITE_HMAC_KEYS=local-v1=Y3VtdXJ1LWxvY2FsLXRlc3QtaW52aXRlLWtleS12MS0wMDA=
ACTOR_HMAC_CURRENT_VERSION=local-v1
ACTOR_HMAC_KEYS=local-v1=Y3VtdXJ1LWxvY2FsLXRlc3QtYWN0b3Ita2V5LXYxLTAwMDA=
IDEMPOTENCY_HMAC_CURRENT_VERSION=local-v1
IDEMPOTENCY_HMAC_KEYS=local-v1=Y3VtdXJ1LWxvY2FsLXRlc3QtaWRlbXBvdGVuY3ktdjEtMDA=
RATE_LIMIT_HMAC_CURRENT_VERSION=local-v1
RATE_LIMIT_HMAC_KEYS=local-v1=Y3VtdXJ1LWxvY2FsLXRlc3QtcmF0ZS1saW1pdC12MS0wMDA=
CURSOR_HMAC_CURRENT_VERSION=local-v1
CURSOR_HMAC_KEYS=local-v1=Y3VtdXJ1LWxvY2FsLXRlc3QtY3Vyc29yLWtleS12MS0wMDA=

# Fase 3 permanece habilitada somente em local/teste com fixtures fictícias.
PHASE3_ENABLED=true
SURVEY_CAPABILITY_TTL=24h
SURVEY_FREE_TEXT_TTL=24h
SURVEY_SUBMIT_RATE_LIMIT=10
SURVEY_FREE_TEXT_CLEANUP_ENABLED=true
SURVEY_HMAC_CURRENT_VERSION=local-v1
SURVEY_HMAC_KEYS=local-v1=Y3VtdXJ1LWxvY2FsLXRlc3Qtc3VydmV5LWhtYWMtdjEtMDAw
SURVEY_FREE_TEXT_CURRENT_VERSION=local-v1
SURVEY_FREE_TEXT_KEYS=local-v1=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Fase 4: política técnica congelada, somente fixtures fictícias local/teste.
PHASE4_ENABLED=true
PUBLIC_DATABASE_TIMEOUT=3s
PHASE4_PRIMARY_CELL_THRESHOLD=10
PHASE4_MINIMUM_REPORTING_ACCOMMODATIONS=3
PHASE4_ROUNDING_BASE=10
PHASE4_PRE_REGISTERED_WEIGHT=0.80
PHASE4_INCREMENTAL_INTERVAL=15m
PHASE4_FULL_RECONCILIATION_INTERVAL=24h
