# Somente protótipo local/teste com dados e chaves fictícios.
# Nenhum valor deste arquivo é segredo ou pode ser reutilizado em produção.
APP_ENV=local
LOG_LEVEL=info

# Autenticação local por e-mail e senha. Valores fictícios de protótipo.
LOCAL_AUTH_ENABLED=true
SESSION_IDLE_TTL=30m
SESSION_ABSOLUTE_TTL=12h
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m
LOCAL_DEMO_ACCOUNT_PASSWORD=demonstracao-local-2026
HTTP_ADDRESS=127.0.0.1:8080
OPERATIONS_ADDRESS=127.0.0.1:9090
# O worker não serve HTTP público; expõe somente operações.
WORKER_OPERATIONS_ADDRESS=127.0.0.1:9091
DATABASE_URL=postgres://cumuru_app:cumuru-local-app-only@127.0.0.1:5432/cumuru?sslmode=disable
PUBLIC_DATABASE_URL=postgres://cumuru_public:cumuru-local-public-only@127.0.0.1:5432/cumuru?sslmode=disable
# Timeouts explícitos; repetem os defaults do loader para servirem de
# referência ao renderizar staging/produção.
DATABASE_TIMEOUT=3s
SHUTDOWN_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
OIDC_MODE=fake
OIDC_ISSUER=https://oidc.invalid/local
OIDC_AUDIENCE=cumuru-local
OIDC_HTTP_TIMEOUT=5s
OTEL_EXPORTER=none
# Sem exportador o endpoint não é exigido; a chave fica declarada para
# que ligar OTLP em local seja uma troca de valor, não de arquivo.
OTEL_ENDPOINT=
OTEL_TIMEOUT=5s
# API + Vite nativos no host confiam somente em loopback.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Compose usa uma variável separada e confia somente no container web.
COMPOSE_TRUSTED_PROXY_CIDRS=172.30.0.10/32

INVITE_BASE_URL=http://127.0.0.1:4173/convites
INVITE_TTL=72h
IDEMPOTENCY_TTL=720h
RATE_LIMIT_WINDOW=1m
INVITE_CONTEXT_RATE_LIMIT=30
INVITE_SUBMIT_RATE_LIMIT=10
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:5173
# Cadastro autônomo de hospedagem: aceito apenas em local/test com OIDC
# fake. O compose local liga o mesmo valor no serviço api.
ACCOMMODATION_ONBOARDING_ENABLED=true

# Fixtures deliberadamente legíveis, independentes e exclusivas de local/teste.
INVITE_HMAC_CURRENT_VERSION=local-v1
INVITE_HMAC_KEYS=local-v1=Y3VtdXJ1LWxvY2FsLXRlc3QtaW52aXRlLWtleS12MS0wMDA=
ACTOR_HMAC_CURRENT_VERSION=local-v1
ACTOR_HMAC_KEYS=local-v1=Y3VtdXJ1LWxvY2FsLXRlc3QtYWN0b3Ita2V5LXYxLTAwMDA=
IDEMPOTENCY_HMAC_CURRENT_VERSION=local-v1
IDEMPOTENCY_HMAC_KEYS=local-v1=Y3VtdXJ1LWxvY2FsLXRlc3QtaWRlbXBvdGVuY3ktdjEtMDA=
RATE_LIMIT_HMAC_CURRENT_VERSION=local-v1
RATE_LIMIT_HMAC_KEYS=local-v1=Y3VtdXJ1LWxvY2FsLXRlc3QtcmF0ZS1saW1pdC12MS0wMDA=
CURSOR_HMAC_CURRENT_VERSION=local-v1
CURSOR_HMAC_KEYS=local-v1=Y3VtdXJ1LWxvY2FsLXRlc3QtY3Vyc29yLWtleS12MS0wMDA=
DOCUMENT_HMAC_CURRENT_VERSION=local-v1
DOCUMENT_HMAC_KEYS=local-v1=Y3VtdXJ1LWxvY2FsLXRlc3QtZG9jdW1lbnQtdjEtMDA=

# O questionário permanece habilitado somente em local/teste com fixtures fictícias.
QUESTIONNAIRE_ENABLED=true
SURVEY_CAPABILITY_TTL=24h
SURVEY_FREE_TEXT_TTL=24h
SURVEY_SUBMIT_RATE_LIMIT=10
SURVEY_FREE_TEXT_CLEANUP_ENABLED=true
SURVEY_HMAC_CURRENT_VERSION=local-v1
SURVEY_HMAC_KEYS=local-v1=Y3VtdXJ1LWxvY2FsLXRlc3Qtc3VydmV5LWhtYWMtdjEtMDAw
SURVEY_FREE_TEXT_CURRENT_VERSION=local-v1
SURVEY_FREE_TEXT_KEYS=local-v1=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Analytics: política técnica congelada, somente fixtures fictícias local/teste.
ANALYTICS_ENABLED=true
PUBLIC_DATABASE_TIMEOUT=3s
ANALYTICS_PRIMARY_CELL_THRESHOLD=10
ANALYTICS_MINIMUM_REPORTING_ACCOMMODATIONS=3
ANALYTICS_ROUNDING_BASE=10
ANALYTICS_PRE_REGISTERED_WEIGHT=0.80
ANALYTICS_INCREMENTAL_INTERVAL=15m
ANALYTICS_FULL_RECONCILIATION_INTERVAL=24h

# Camada de contexto externo (ADR-045). Desligada por padrão: ligá-la abre o
# primeiro egresso HTTP do produto para internet pública. O egresso sai só do
# worker, com URL e parâmetros constantes, e a allowlist de host mora aqui, em
# configuração — nunca em banco, para que um UPDATE não vire SSRF.
EXTERNAL_CONTEXT_ENABLED=true
EXTERNAL_ALLOWED_HOSTS=api.open-meteo.com
EXTERNAL_REQUEST_TIMEOUT=10s
# DATABASE_TIMEOUT é de requisição e não serve a ciclo de ingestão.
EXTERNAL_BATCH_BUDGET=2m
EXTERNAL_MAX_RESPONSE_BYTES=2097152
EXTERNAL_INGESTION_INTERVAL=6h
# Papel dedicado da ingestão: o loader recusa papéis repetidos, e é isso que
# faz o modelo de grants da migration 000003 constranger alguma coisa.
EXTERNAL_DATABASE_URL=postgres://cumuru_external:cumuru-local-external-only@127.0.0.1:5432/cumuru?sslmode=disable

# Semeadura local. O binário local-demo aplica as fixtures fictícias; o binário
# seed cobre o mesmo caminho de bootstrap usado em staging/produção. Cada
# processo conecta com um papel distinto — o loader recusa papéis repetidos.
LOCAL_DEMO_ENABLED=true
WORKER_DATABASE_URL=postgres://cumuru_worker:cumuru-local-worker-only@127.0.0.1:5432/cumuru?sslmode=disable
PROVISIONING_DATABASE_URL=postgres://cumuru_migration:cumuru-local-migration-only@127.0.0.1:5432/cumuru?sslmode=disable
SEED_ENABLED=true
# admin+demo carrega fixtures fictícias e é recusado fora de local/test.
SEED_PROFILE=admin+demo
SEED_ADMIN_EMAIL=administracao@cumuru.local
SEED_ADMIN_DISPLAY_NAME=Administração Cumuru
SEED_ADMIN_PASSWORD=administracao-local-2026
# Somente local/test aceita false; staging e produção exigem troca no 1º login.
SEED_ADMIN_MUST_CHANGE_PASSWORD=false
SEED_ACCOMMODATION_CATALOG=seeds/accommodations.example.json
