_workspace/

# AI assistants and local agent workspaces. The patterns are unanchored so a
# workspace created inside apps/api or apps/web is ignored like the root one.
#
# .agents/ is deliberately NOT ignored: it holds the canonical harness that
# prompts/BOOTSTRAP-CODEX.md and the Makefile phase targets reference. Ignoring
# it would ship those references pointing at files nobody else has. The runtime
# artifacts it produces stay out through the _workspace/ rule above.
.claude/
.codex/
.aider/
.augment/
.cline/
.continue/
.cursor/
.gemini/
.goose/
.junie/
.kilocode/
.opencode/
.qodo/
.roo/
.tabnine/
.windsurf/

# Local editor and operating-system metadata
/.idea/
/.vscode/
.DS_Store

.env
.env.*
!.env.example
.tools/
artifacts/
node_modules/
apps/web/dist/
coverage/
*.log
